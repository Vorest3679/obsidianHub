# Absolute path to the Obsidian Vault directory on the host.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian-vault

# Optional: logged-in Zhihu Cookie copied from your browser.
# The cookie should include at least z_c0 for routes that require login.
ZHIHU_COOKIES=

# Optional: logged-in Bilibili Cookie for the UID used in config.json.
# For video/article routes, SESSDATA is usually the important part;
# copying the complete Cookie header is more reliable when anti-crawling is active.
BILIBILI_COOKIE_2267573=
